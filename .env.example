# ==============================================================================
# Ciel Desktop Assistant - Environment Configuration Example
# Copy this file to .env and adjust variables to suit your environment.
# ==============================================================================

# Server Configuration
CIEL_HOST=127.0.0.1
CIEL_PORT=5000
CIEL_DEBUG=false
CIEL_LOG_LEVEL=INFO

# Workspace & Storage Paths
# Defaults to project root if left unset
# CIEL_WORKSPACE=C:\Users\Lenovo\Ciel
# CIEL_CHATS_DIR=C:\Users\Lenovo\Ciel\chats
# CIEL_IMAGE_DIR=C:\Users\Lenovo\Ciel\app\static\images

# Local Model Storage
# HF_HOME=C:\Users\Lenovo\Ciel\models\huggingface
# OLLAMA_MODELS=C:\Users\Lenovo\Ciel\models\ollama

# Ollama LLM Engine
OLLAMA_API_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b
OLLAMA_FAST_MODEL=qwen2.5-coder:1.5b
OLLAMA_REASONING_MODEL=qwen3:latest
OLLAMA_VISION_MODEL=llava:7b
OLLAMA_TIMEOUT_SECONDS=120

# Voice & Speech Synthesis
CIEL_TTS_VOICE=en-US-AriaNeural
CIEL_TTS_PITCH=+14Hz
CIEL_TTS_RATE=+5%
CIEL_WAKE_TIMEOUT=10
CIEL_WHISPER_MODEL=base.en

# Safety & Execution Limits
CIEL_COMMAND_TIMEOUT=30
CIEL_PERMISSION_TIMEOUT=120
CIEL_MAX_IMAGE_WIDTH=1024
CIEL_MAX_IMAGE_HEIGHT=1024
CIEL_MAX_CODE_SIZE=500000
CIEL_MAX_OUTPUT_LENGTH=100000
